{
  "name": "opencode-pagey",
  "version": "1.0.0",
  "description": "Free static site publishing from OpenCode: preview, deploy, and update on Pagey Site.",
  "type": "module",
  "license": "MIT",
  "author": "Nitin Bansal",
  "repository": {
    "type": "git",
    "url": "https://github.com/freakynit/opencode-pagey.git"
  },
  "homepage": "https://github.com/freakynit/opencode-pagey#readme",
  "bugs": "https://github.com/freakynit/opencode-pagey/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "pagey",
    "static-site",
    "hosting",
    "deploy"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "index.js"
  ],
  "scripts": {
    "typecheck": "bun run typecheck:tsc",
    "typecheck:tsc": "tsgo --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build:plugin",
    "prepublishOnly": "bun run check",
    "build:plugin": "bun build src/index.ts --outdir dist --target bun --external zod --external fflate"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.1",
    "@types/bun": "^1.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "main": "./dist/index.js"
}
